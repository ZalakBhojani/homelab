# Rendered by ansible/deploy-apps.yml — targets come from the [homelab]
# inventory group. Edit this .j2, not the rendered prometheus.yml.
global:
  scrape_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - localhost:9090

  # Host metrics — node_exporter runs as a systemd service on every host.
  # Each target carries a `node` display label (host_vars node_name) so
  # dashboards can show a hostname instead of the scrape address; target
  # labels survive on `up` even while the host is down.
  - job_name: node
    static_configs:
{% for host in groups['homelab'] %}
      - targets: ["{{ host }}:9100"]
        labels:
          node: "{{ hostvars[host].node_name | default(host) }}"
{% endfor %}

  # Per-container metrics — the cadvisor app stack on every host.
  - job_name: cadvisor
    static_configs:
{% for host in groups['homelab'] %}
      - targets: ["{{ host }}:8080"]
        labels:
          node: "{{ hostvars[host].node_name | default(host) }}"
{% endfor %}
